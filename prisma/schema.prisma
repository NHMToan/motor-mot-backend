generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum ProductCategory {
  MOTOR_GIAM_TOC
  HOP_SO_GIAM_TOC
  DAU_GIAM_TOC
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id                String          @id @default(cuid())
  name              String
  slug              String          @unique
  category          ProductCategory
  sku               String          @unique
  summary           String
  description       String
  descriptionBlocks Json?
  galleryImages     Json?
  price             Decimal         @db.Decimal(12, 2)
  imageUrl          String?
  featured          Boolean         @default(false)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([featured])
  @@index([active])
}
